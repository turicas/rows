@@ -107,10 +107,22 @@ FRAMES = {
 
 
 def _clean_style_name(name):
+    """Normalize a frame style name for lookup in FRAMES.
+
+    Lowercases the name and strips surrounding whitespace, so values such
+    as " ASCII " and "ascii" are treated as the same frame style.
+    """
     return name.lower().strip()
 
 
 def _parse_frame_style(frame_style):
+    """Validate a frame style name and return its normalized form.
+
+    A None value means no frame was requested and is normalized to "none".
+    Any other value is cleaned with _clean_style_name and must be one of
+    the keys of FRAMES ("none", "ascii", "single", "double"); anything else
+    raises a ValueError.
+    """
     frame_style = _clean_style_name(frame_style) if frame_style is not None else "none"
     if frame_style not in FRAMES:
         raise ValueError("Invalid frame style {}. Use one of: {}.".format(repr(frame_style), ", ".join(FRAMES.keys())))
@@ -118,6 +130,13 @@ def _parse_frame_style(frame_style):
 
 
 def _guess_frame_style(contents):
+    """Guess the frame style of a plain-text table from its first line.
+
+    The characters of the first line are compared against the characters
+    used by each frame in FRAMES; the first frame whose characters contain
+    them all wins. Returns "none" when no frame matches, which is the case
+    for tables drawn without any border characters.
+    """
     first_line_chars = set(contents.split("\n")[0].strip())
     for frame_style, frame_dict in FRAMES.items():
         if first_line_chars <= set(frame_dict.values()):
@@ -149,6 +168,12 @@ def _parse_col_positions(frame_style, header_line):
 
 
 def _max_column_sizes(field_names, table_rows):
+    """Return the maximum rendered width of each column.
+
+    The width of a column is the length of its longest value, considering
+    both the field name and every row value. The result maps each field name
+    to its width and is used to align columns when exporting a table.
+    """
     columns = zip(*([field_names] + table_rows))
     return {field_name: max(len(value) for value in column) for field_name, column in zip(field_names, columns)}
 
